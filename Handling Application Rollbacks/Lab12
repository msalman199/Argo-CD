Subtask 2.7: Implement Rollback Best Practices
Step 1: Create rollback automation script

cat << 'EOF' > rollback-automation.sh
#!/bin/bash

APP_NAME="rollback-demo-app"
NAMESPACE="demo-app"

# Function to check application health
check_app_health() {
    local app_name=$1
    local max_attempts=30
    local attempt=1
    
    echo "Checking application health..."
    while [ $attempt -le $max_attempts ]; do
        health_status=$(argocd app get $app_name -o json | jq -r '.status.health.status')
        sync_status=$(argocd app get $app_name -o json | jq -r '.status.sync.status')
        
        if [ "$health_status" = "Healthy" ] && [ "$sync_status" = "Synced" ]; then
            echo "Application is healthy and synced"
            return 0
        fi
        
        echo "Attempt $attempt/$max_attempts: Health=$health_status, Sync=$sync_status"
        sleep 10
        ((attempt++))
    done
    
    echo "Application failed to become healthy within timeout"
    return 1
}

# Function to perform rollback
perform_rollback() {
    local app_name=$1
    local target_revision=$2
    
    echo "Performing rollback of $app_name to revision $target_revision"
    
    # Execute rollback
    argocd app rollback $app_name --revision $target_revision
    
    # Wait for rollback to complete
    if check_app_health $app_name; then
        echo "Rollback completed successfully"
        
        # Verify deployment
        kubectl get pods -n $NAMESPACE
        kubectl get configmap demo-app-config -n $NAMESPACE -o jsonpath='{.data.version}'
        echo ""
        
        return 0
    else
        echo "Rollback failed or application is unhealthy"
        return 1
    fi
}

# Main execution
if [ $# -ne 1 ]; then
    echo "Usage: $0 <target_revision>"
    echo "Example: $0 v2.0"
    exit 1
fi

TARGET_REVISION=$1
cd ~/rollback-demo-app
REVISION_HASH=$(git rev-parse $TARGET_REVISION 2>/dev/null)

if [ $? -ne 0 ]; then
    echo "Error: Invalid revision $TARGET_REVISION"
    exit 1
fi

echo "Target revision hash: $REVISION_HASH"
perform_rollback $APP_NAME $REVISION_HASH
EOF

chmod +x rollback-automation.sh
