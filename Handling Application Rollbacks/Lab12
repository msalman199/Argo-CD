apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: rollback-demo-app
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: file://$(pwd)
    targetRevision: HEAD
    path: k8s-manifests
  destination:
    server: https://kubernetes.default.svc
    namespace: demo-app
