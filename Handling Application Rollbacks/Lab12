Step 3: Create monitoring and alerting setup

cat << 'EOF' > monitor-rollback.sh
#!/bin/bash

APP_NAME="rollback-demo-app"
NAMESPACE="demo-app"
LOG_FILE="/tmp/rollback-monitor.log"

# Function to log with timestamp
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a $LOG_FILE
}

# Monitor application continuously
monitor_application() {
    log_message "Starting application monitoring for $APP_NAME"
    
    while true; do
        # Get application status
        health_status=$(argocd app get $APP_NAME -o json 2>/dev/null | jq -r '.status.health.status // "Unknown"')
        sync_status=$(argocd app get $APP_NAME -o json 2>/dev/null | jq -r '.status.sync.status // "Unknown"')
        
        # Get pod status
        pod_count=$(kubectl get pods -n $NAMESPACE --no-headers 2>/dev/null | wc -l)
        ready_pods=$(kubectl get pods -n $NAMESPACE --no-headers 2>/dev/null | grep "Running" | wc -l)
        
        # Get current version
        current_version=$(kubectl get configmap demo-app-config -n $NAMESPACE -o jsonpath='{.data.version}' 2>/dev/null || echo "Unknown")
        
        log_message "Status - Health: $health_status, Sync: $sync_status, Pods: $ready_pods/$pod_count, Version: $current_version"
        
        # Check for issues
        if [ "$health_status" != "Healthy" ] || [ "$sync_status" != "Synced" ] || [ "$ready_pods" -lt "$pod_count" ]; then
            log_message "WARNING: Application issues detected!"
            
            # Get recent events
            kubectl get events -n $NAMESPACE --sort-by='.lastTimestamp' | tail -5 >> $LOG_FILE
        fi
        
        sleep 30
    done
}

# Start monitoring in background
monitor_application &
MONITOR_PID=$!

echo "Monitoring started with PID: $MONITOR_PID"
echo "Log file: $LOG_FILE"
echo "To stop monitoring: kill $MONITOR_PID"
EOF

chmod +x monitor-rollback.sh
Troubleshooting Common Issues
Issue 1: Rollback Command Fails
Problem: argocd app rollback command returns an error

Solution:

# Check application status
