Task 2: Design and Apply a Multi-Tier RBAC Policy
Step 2.1: Define Local Users, AppProjects, and the RBAC Policy Matrix
Argo CD RBAC is governed by two ConfigMaps: argocd-cm (user accounts and server settings) and argocd-rbac-cm (Casbin policy rules). Casbin is the policy engine Argo CD uses; its rules follow the pattern p, subject, resource, action, object, effect.

Your requirement is to implement the following access matrix without deviation:

User	Role	Permitted	Denied
alice	developer	get/sync any application, read logs	create/delete applications, manage repos
bob	devops	full application lifecycle, manage repositories, read clusters/projects	manage clusters, manage projects
charlie	org-admin	all resources and actions	nothing
You must also create two AppProjects â team-alpha and team-beta â each scoped to its own namespace (alpha-ns and beta-ns). Alice must be additionally constrained so that her sync permission applies only to team-alpha applications, not team-beta.

# 1. Create target namespaces
kubectl create namespace alpha-ns
kubectl create namespace beta-ns
# 2. Register local users in argocd-cm
# The accounts.USERNAME key enables a local login account.
# Do not overwrite existing keys in argocd-cm â patch instead.
kubectl patch configmap argocd-cm -n argocd --type merge -p '{
  "data": {
    "accounts.alice": "login",
    "accounts.bob": "login",
    "accounts.charlie": "login"
  }
}'

kubectl get configmap argocd-cm -n argocd -o jsonpath='{.data}' | tr ',' '\n'
# 3. Set passwords for each local user
ARGOCD_INITIAL_PASSWORD=$(kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath="{.data.password}" | base64 --decode)

argocd account update-password \
  --account alice \
  --new-password "AlicePass#2024" \
  --current-password "${ARGOCD_INITIAL_PASSWORD}"

argocd account update-password \
  --account bob \
  --new-password "BobPass#2024" \
  --current-password "${ARGOCD_INITIAL_PASSWORD}"

argocd account update-password \
  --account charlie \
  --new-password "CharliePass#2024" \
  --current-password "${ARGOCD_INITIAL_PASSWORD}"

argocd account list
# 4. Apply AppProjects
kubectl apply -f - <<'EOF'
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: team-alpha
  namespace: argocd
spec:
  description: "Project scoped to the alpha team namespace"
  sourceRepos:
    - "https://github.com/argoproj/argocd-example-apps.git"
  destinations:
    - namespace: alpha-ns
      server: https://kubernetes.default.svc
  namespaceResourceWhitelist:
    - group: apps
      kind: Deployment
    - group: ""
      kind: Service
    - group: ""
      kind: ConfigMap
EOF

kubectl apply -f - <<'EOF'
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: team-beta
  namespace: argocd
spec:
  description: "Project scoped to the beta team namespace"
  sourceRepos:
    - "https://github.com/argoproj/argocd-example-apps.git"
  destinations:
    - namespace: beta-ns
      server: https://kubernetes.default.svc
  namespaceResourceWhitelist:
    - group: apps
      kind: Deployment
    - group: ""
      kind: Service
    - group: ""
      kind: ConfigMap
EOF

argocd proj list
# 5. Apply the RBAC policy
# policy.default sets the fallback role for any authenticated user not matched by a rule.
# The object field for applications uses the format: PROJECT/APP-NAME
kubectl apply -f - <<'EOF'
apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-rbac-cm
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-rbac-cm
    app.kubernetes.io/part-of: argocd
data:
  policy.default: role:readonly
  policy.csv: |
    # --- role:readonly (built-in baseline) ---
    p, role:readonly, applications, get, */*, allow
    p, role:readonly, projects,     get, *,   allow

    # --- role:developer ---
    p, role:developer, applications, get,      */*, allow
    p, role:developer, applications, sync,     team-alpha/*, allow
    p, role:developer, logs,         get,      */*, allow

    # --- role:devops ---
    p, role:devops, applications,  get,    */*, allow
    p, role:devops, applications,  create, */*, allow
    p, role:devops, applications,  update, */*, allow
    p, role:devops, applications,  delete, */*, allow
    p, role:devops, applications,  sync,   */*, allow
    p, role:devops, repositories,  get,    *,   allow
    p, role:devops, repositories,  create, *,   allow
    p, role:devops, repositories,  update, *,   allow
    p, role:devops, repositories,  delete, *,   allow
    p, role:devops, clusters,      get,    *,   allow
    p, role:devops, projects,      get,    *,   allow
    p, role:devops, logs,          get,    */*, allow

    # --- role:org-admin ---
    p, role:org-admin, *, *, *, allow

    # --- user-to-role bindings ---
    g, alice,   role:developer
    g, bob,     role:devops
    g, charlie, role:org-admin
EOF

kubectl get configmap argocd-rbac-cm -n argocd -o jsonpath='{.data.policy\.csv}'
# 6. Restart argocd-server so it reloads both ConfigMaps
kubectl rollout restart deployment/argocd-server -n argocd
kubectl wait --for=condition=available --timeout=120s deployment/argocd-server -n argocd
Confirmation: kubectl get configmap argocd-rbac-cm -n argocd -o jsonpath='{.data.policy\.csv}' must print all policy lines without truncation.

