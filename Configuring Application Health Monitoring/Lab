Subtask 4.2: Create Health Dashboard Script
Create a comprehensive health monitoring dashboard:

# Create health dashboard script
cat <<EOF > health-dashboard.sh
#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

clear_screen() {
    clear
    echo -e "\${BLUE}=== Argo CD Application Health Dashboard ===\${NC}"
    echo -e "Application: sample-app-health-monitor"
    echo -e "Timestamp: \$(date)"
    echo -e "Press Ctrl+C to exit\n"
}

get_health_status() {
    local app_name=\$1
    local status=\$(argocd app get \$app_name --output json 2>/dev/null)
    
    if [ \$? -eq 0 ]; then
        local health=\$(echo "\$status" | jq -r '.status.health.status // "Unknown"')
        local sync=\$(echo "\$status" | jq -r '.status.sync.status // "Unknown"')
        local revision=\$(echo "\$status" | jq -r '.status.sync.revision[0:8] // "Unknown"')
        
        # Color code health status
        case \$health in
            "Healthy") health_color="\${GREEN}\$health\${NC}" ;;
            "Progressing") health_color="\${YELLOW}\$health\${NC}" ;;
            "Degraded"|"Missing") health_color="\${RED}\$health\${NC}" ;;
            *) health_color="\$health" ;;
        esac
        
        # Color code sync status
        case \$sync in
            "Synced") sync_color="\${GREEN}\$sync\${NC}" ;;
            "OutOfSync") sync_color="\${RED}\$sync\${NC}" ;;
            *) sync_color="\$sync" ;;
        esac
        
        echo -e "Health Status: \$health_color"
        echo -e "Sync Status: \$sync_color"
        echo -e "Git Revision: \$revision"
        
        # Show resource details
        echo -e "\n\${BLUE}Resource Status:\${NC}"
        echo "\$status" | jq -r '.status.resources[]? | "  \(.kind)/\(.name): \(.status)"' 2>/dev/null
        
        # Show conditions
        echo -e "\n\${BLUE}Application Conditions:\${NC}"
        echo "\$status" | jq -r '.status.conditions[]? | "  \(.type): \(.message)"' 2>/dev/null
        
    else
        echo -e "\${RED}Failed to get application status\${NC}"
    fi
}

get_cluster_resources() {
    echo -e "\n\${BLUE}Cluster Resources:\${NC}"
    echo -e "\${YELLOW}Deployments:\${NC}"
    kubectl get deployments -l app=sample-app -o custom-columns="NAME:.metadata.name,READY:.status.readyReplicas,UP-TO-DATE:.status.updatedReplicas,AVAILABLE:.status.availableReplicas" 2>/dev/null
    
    echo -e "\n\${YELLOW}Pods:\${NC}"
    kubectl get pods -l app=sample-app -o custom-columns="NAME:.metadata.name,STATUS:.status.phase,READY:.status.conditions[?(@.type=='Ready')].status" 2>/dev/null
    
    echo -e "\n\${YELLOW}Services:\${NC}"
    kubectl get services -l app=sample-app -o custom-columns="NAME:.metadata.name,TYPE:.spec.type,CLUSTER-IP:.spec.clusterIP" 2>/dev/null
}

# Main monitoring loop
while true; do
    clear_screen
    get_health_status "sample-app-health-monitor"
    get_cluster_resources
    echo -e "\n\${BLUE}Next update in 15 seconds...\${NC}"
    sleep 15
done
EOF

chmod +x health-dashboard.sh

# Run the dashboard
echo "Starting health dashboard..."
echo "This will run for 2 minutes, then automatically stop"
timeout 120 ./health-dashboard.sh || echo "Dashboard monitoring completed"
