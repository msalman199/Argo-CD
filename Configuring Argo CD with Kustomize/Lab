Task 2: Create and Deploy a Custom Application with Kustomize using Argo CD
Subtask 2.1: Install Argo CD
# Create Argo CD namespace
kubectl create namespace argocd

# Install Argo CD
kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml

# Wait for Argo CD to be ready
echo "Waiting for Argo CD to be ready..."
kubectl wait --for=condition=available --timeout=300s deployment/argocd-server -n argocd

# Verify Argo CD installation
kubectl get all -n argocd
Subtask 2.2: Install Argo CD CLI
# Download Argo CD CLI
curl -sSL -o argocd-linux-amd64 https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64

# Make it executable
chmod +x argocd-linux-amd64

# Move to PATH
sudo mv argocd-linux-amd64 /usr/local/bin/argocd

# Verify installation
argocd version --client
Subtask 2.3: Access Argo CD UI
# Port forward to access Argo CD UI
kubectl port-forward svc/argocd-server -n argocd 8080:443 &

# Get initial admin password
ARGOCD_PASSWORD=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)
echo "Argo CD Admin Password: $ARGOCD_PASSWORD"

# Login to Argo CD CLI (in a new terminal or after stopping port-forward)
# First, stop the background port-forward if needed
# pkill -f "kubectl port-forward svc/argocd-server"

# Start port-forward again for CLI login
kubectl port-forward svc/argocd-server -n argocd 8080:443 > /dev/null 2>&1 &
sleep 5

# Login via CLI
argocd login localhost:8080 --username admin --password $ARGOCD_PASSWORD --insecure

echo "Argo CD is accessible at: https://localhost:8080"
echo "Username: admin"
echo "Password: $ARGOCD_PASSWORD"
Subtask 2.4: Initialize Git Repository
# Initialize git repository for our application
cd ~/argocd-kustomize-lab
git init

# Configure git (replace with your information)
git config user.name "Lab User"
git config user.email "labuser@example.com"

# Add all files
git add .

# Initial commit
git commit -m "Initial commit: Kustomize application structure"

# Create a bare repository to simulate remote repo
cd ~
git init --bare argocd-kustomize-repo.git

# Add remote to our working directory
cd ~/argocd-kustomize-lab
git remote add origin ~/argocd-kustomize-repo.git

# Push to our "remote" repository
git push -u origin master
Subtask 2.5: Create Argo CD Application for Development
# Create development application
cat << EOF > dev-application.yaml
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sample-app-dev
  namespace: argocd
spec:
  project: default
  source:
    repoURL: file:///home/$(whoami)/argocd-kustomize-repo.git
    targetRevision: HEAD
    path: overlays/development
  destination:
    server: https://kubernetes.default.svc
    namespace: development
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
EOF

# Apply the application
kubectl apply -f dev-application.yaml

# Verify application creation
argocd app list
Subtask 2.6: Create Argo CD Application for Production
# Create production application
cat << EOF > prod-application.yaml
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sample-app-prod
  namespace: argocd
spec:
  project: default
  source:
    repoURL: file:///home/$(whoami)/argocd-kustomize-repo.git
    targetRevision: HEAD
    path: overlays/production
  destination:
    server: https://kubernetes.default.svc
    namespace: production
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
EOF

# Apply the application
kubectl apply -f prod-application.yaml

# List all applications
argocd app list
Subtask 2.7: Monitor Application Deployment
# Check application status
argocd app get sample-app-dev
argocd app get sample-app-prod

# Sync applications if needed
argocd app sync sample-app-dev
argocd app sync sample-app-prod

# Wait for applications to be healthy
echo "Waiting for applications to be healthy..."
argocd app wait sample-app-dev --health
argocd app wait sample-app-prod --health

# Verify deployments in Kubernetes
echo "=== Development Environment ==="
kubectl get all -n development

echo -e "\n=== Production Environment ==="
kubectl get all -n production
Subtask 2.8: Test GitOps Workflow
# Make a change to the base application
cd ~/argocd-kustomize-lab

# Update the nginx image version in base
sed -i 's/nginx:1.21/nginx:1.22/g' base/deployment.yaml

# Commit and push changes
git add .
git commit -m "Update nginx to version 1.22"
git push origin master

# Refresh applications to detect changes
argocd app refresh sample-app-dev
argocd app refresh sample-app-prod

# Check application status
argocd app get sample-app-dev
argocd app get sample-app-prod

# Applications should automatically sync due to automated sync policy
# Wait for sync to complete
sleep 30

# Verify the changes were applied
kubectl describe deployment sample-app -n development | grep Image
kubectl describe deployment sample-app -n production | grep Image
Subtask 2.9: Create Custom Kustomize Components
# Create a configmap component
mkdir -p components/configmap

cat << EOF > components/configmap/configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
data:
  app.properties: |
    app.name=sample-app
    app.version=1.0.0
    log.level=INFO
EOF

cat << EOF > components/configmap/kustomization.yaml
apiVersion: kustomize.config.k8s.io/v1alpha1
kind: Component

resources:
- configmap.yaml
EOF

# Update base to include the component
cat << EOF > base/kustomization.yaml
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
- deployment.yaml
- service.yaml

components:
- ../components/configmap

commonLabels:
  environment: base
  managed-by: kustomize
EOF

# Update deployment to use configmap
cat << EOF > base/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: sample-app
  labels:
    app: sample-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: sample-app
  template:
    metadata:
      labels:
        app: sample-app
    spec:
      containers:
      - name: sample-app
        image: nginx:1.22
        ports:
        - containerPort: 80
        resources:
          requests:
            memory: "64Mi"
            cpu: "250m"
          limits:
            memory: "128Mi"
            cpu: "500m"
        volumeMounts:
        - name: config-volume
          mountPath: /etc/config
      volumes:
      - name: config-volume
        configMap:
          name: app-config
EOF

# Test the updated configuration
kubectl kustomize overlays/development

# Commit and push changes
git add .
git commit -m "Add configmap component"
git push origin master

# Refresh and sync applications
argocd app refresh sample-app-dev
argocd app refresh sample-app-prod

# Wait for sync
sleep 30

# Verify configmap was created
kubectl get configmap -n development
kubectl get configmap -n production
